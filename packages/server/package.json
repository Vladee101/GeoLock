{
  "name": "@geolock/server",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup src/server.ts --format esm --out-dir dist",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts"
  },
  "dependencies": {
    "fastify": "^5.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "pg": "^8.12.0",
    "bcrypt": "^5.1.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "tsx": "^4.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "@types/pg": "^8.11.0",
    "@types/bcrypt": "^5.0.2",
    "@types/uuid": "^10.0.0",
    "@types/node": "^20.0.0"
  }
}
